{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "target": "ES2020",
        "allowJs": true,
        "moduleDetection": "force",
        "skipLibCheck": true,
        "outDir": "dist",
        "sourceMap": true,
        "declaration": true
    }
}